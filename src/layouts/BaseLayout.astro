---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = "Neuroweave" } = Astro.props;

const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/neuroweavelogo.png" />
    <link rel="shortcut icon" href="/neuroweavelogo.png" />
    <link rel="apple-touch-icon" href="/neuroweavelogo.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600&family=Noto+Serif+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    >

    <!-- 尽早应用保存的模式 -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('nw-sensory-theme') === 'true') {
            document.documentElement.classList.add('sensory-theme');
          }

          if (localStorage.getItem('nw-sans-serif-theme') === 'true') {
            document.documentElement.classList.add('sans-serif-theme');
          }

          if (
            document.documentElement.lang === 'en' &&
            localStorage.getItem('nw-bionic-theme') === 'true'
          ) {
            document.documentElement.classList.add('bionic-theme');
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <Nav />

    <slot />

    <Footer />

    <!-- Bionic Reading -->
    <script>
      const BIONIC_CLASS = 'bionic-text';

      /*
       * 保存 <main> 最初的 HTML。
       *
       * 每次重新切换 Bionic Reading 时，
       * 都从这个最初状态重新生成。
       */
      let originalMainHTML = null;

      function isEnglishPage() {
        return document.documentElement.lang === 'en';
      }

      /*
       * 保存 main 的原始内容。
       *
       * 只保存一次。
       */
      function saveOriginalMain() {
        const main = document.querySelector('main');

        if (!main) {
          return;
        }

        if (originalMainHTML === null) {
          originalMainHTML = main.innerHTML;
        }
      }

      /*
       * 将 main 完整恢复成最初状态。
       *
       * 不使用 document.body.innerHTML，
       * 避免破坏 Nav / Footer 以及它们的事件监听。
       */
      function restoreOriginalMain() {
        const main = document.querySelector('main');

        if (!main || originalMainHTML === null) {
          return;
        }

        main.innerHTML = originalMainHTML;
      }

      /*
       * 决定一个英文单词有多少比例需要加粗。
       *
       * 固定为前 40%。
       * 至少 1 个字符。
       * 不会让整个单词都变粗。
       */
      function getBionicPart(word) {
        if (!/^[A-Za-zÀ-ÖØ-öø-ÿ]+$/.test(word)) {
          return '';
        }

        // 单字符单词不处理
        if (word.length <= 1) {
          return '';
        }

        const count = Math.max(
          1,
          Math.round(word.length * 0.4)
        );

        // 防止整个单词都被加粗
        if (count >= word.length) {
          return word.slice(0, word.length - 1);
        }

        return word.slice(0, count);
      }

      /*
       * 创建一个 Bionic Reading 单词。
       *
       * 例如：
       *
       * knowledge
       * ↓
       * know + ledge
       */
      function createBionicWord(word) {
        const boldPart = getBionicPart(word);

        if (!boldPart) {
          return document.createTextNode(word);
        }

        const fragment =
          document.createDocumentFragment();

        const strong =
          document.createElement('strong');

        strong.className = BIONIC_CLASS;
        strong.textContent = boldPart;

        fragment.appendChild(strong);

        fragment.appendChild(
          document.createTextNode(
            word.slice(boldPart.length)
          )
        );

        return fragment;
      }

      /*
       * 处理一个普通文字节点。
       */
      function processTextNode(textNode) {
        const text = textNode.textContent;

        if (!text || !text.trim()) {
          return;
        }

        /*
         * 匹配：
         *
         * accessibility
         * neurodivergent
         * don't
         * we're
         * user's
         *
         * apostrophe 会保留。
         */
        const parts = text.split(
          /([A-Za-zÀ-ÖØ-öø-ÿ]+(?:['’][A-Za-zÀ-ÖØ-öø-ÿ]+)*)/g
        );

        const fragment =
          document.createDocumentFragment();

        parts.forEach((part) => {
          /*
           * 普通英文单词或 contraction
           */
          if (
            /^[A-Za-zÀ-ÖØ-öø-ÿ]+(?:['’][A-Za-zÀ-ÖØ-öø-ÿ]+)*$/.test(
              part
            )
          ) {
            /*
             * 如果是 contraction：
             *
             * don't
             * ↓
             * don + 't
             *
             * 只对 apostrophe 前面的部分应用 Bionic。
             */
            const match = part.match(
              /^([A-Za-zÀ-ÖØ-öø-ÿ]+)(['’].*)$/
            );

            if (match) {
              fragment.appendChild(
                createBionicWord(match[1])
              );

              fragment.appendChild(
                document.createTextNode(match[2])
              );
            } else {
              fragment.appendChild(
                createBionicWord(part)
              );
            }
          } else {
            /*
             * 标点、空格、中文等保持原样。
             */
            fragment.appendChild(
              document.createTextNode(part)
            );
          }
        });

        textNode.parentNode?.replaceChild(
          fragment,
          textNode
        );
      }

      /*
       * 应用 Bionic Reading。
       *
       * 只遍历 <main>。
       *
       * 因此：
       * - Nav 不处理
       * - Footer 不处理
       * - button 不处理
       * - code 不处理
       * - pre 不处理
       * - 原本的 strong / b 不处理
       */
      function applyBionicReading() {
        if (!isEnglishPage()) {
          return;
        }

        const main = document.querySelector('main');

        if (!main) {
          return;
        }

        /*
         * 遍历 main 内的文字节点。
         */
        const walker = document.createTreeWalker(
          main,
          NodeFilter.SHOW_TEXT,
          {
            acceptNode(node) {
              const parent = node.parentElement;

              if (!parent) {
                return NodeFilter.FILTER_REJECT;
              }

              /*
               * 排除不应该被 Bionic 处理的元素。
               */
              if (
                parent.closest(
                  'script, style, code, pre, textarea, input, select, button, strong, b, .bionic-text'
                )
              ) {
                return NodeFilter.FILTER_REJECT;
              }

              /*
               * 空白文字节点跳过。
               */
              if (!node.textContent?.trim()) {
                return NodeFilter.FILTER_REJECT;
              }

              return NodeFilter.FILTER_ACCEPT;
            }
          }
        );

        /*
         * 先收集 text nodes。
         *
         * 不在 TreeWalker 遍历过程中直接修改 DOM。
         */
        const textNodes = [];

        let node;

        while ((node = walker.nextNode())) {
          textNodes.push(node);
        }

        /*
         * 再统一处理。
         */
        textNodes.forEach(processTextNode);
      }

      /*
       * 统一刷新 Bionic Reading。
       *
       * 每次都严格执行：
       *
       * 1. 确认英文页面
       * 2. 保存最初的 main
       * 3. 恢复 main 到最初状态
       * 4. 如果关闭 → 停止
       * 5. 如果开启 → 从干净 DOM 重新生成
       */
      function updateBionicReading() {
        /*
         * 中文页面永远不处理。
         */
        if (!isEnglishPage()) {
          return;
        }

        /*
         * 第一次执行时保存原始 main。
         */
        saveOriginalMain();

        /*
         * 无论当前是什么状态，
         * 先恢复到完全干净的原始状态。
         */
        restoreOriginalMain();

        /*
         * 如果 Bionic 当前没有开启，
         * 保持普通文字即可。
         */
        if (
          !document.documentElement.classList.contains(
            'bionic-theme'
          )
        ) {
          return;
        }

        /*
         * 从原始 DOM 重新生成一次。
         */
        applyBionicReading();
      }

      /*
       * Nav 点击 Bionic Reading 按钮后，
       * 会发送这个事件。
       */
      window.addEventListener(
        'nw-update-bionic',
        updateBionicReading
      );

      /*
       * 页面第一次加载时执行一次。
       */
      updateBionicReading();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #F8F4E6;
    --bg-nav: #F2EDD8;
    --bg-card: #F5EBCF;
    --card-header-bg: #EADCB8;

    --text-primary: #2C2C2C;
    --text-muted: #6B6A65;
    --accent-border: rgba(70, 65, 50, 0.08);

  /* Serif：中文思源宋体 + 英文 Georgia */
   --font-serif:
   "Noto Serif SC",
   Georgia,
   serif;

    /* Sans-serif：中文更纱黑体 + 英文 Lexend */
    --font-sans:
      "Lexend",
      "Sarasa Gothic SC",
      "更纱黑体 SC",
      sans-serif;

    --font-main: var(--font-serif);
  }

  :root.sans-serif-theme {
    --font-main: var(--font-sans);
  }

  :root.sensory-theme {
    --bg-main: #161B24;
    --bg-nav: #1E2430;
    --bg-card: #1E2430;
    --text-primary: #93A8C7;
    --text-muted: #6E7F98;
    --accent-border: rgba(255, 255, 255, 0.08);
    --badge-bg: #2A3B4D;
    --card-header-bg: #171B24;
  }

  .bionic-text {
    font-weight: 600;
  }

  main strong {
    font-weight: 600;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: var(--font-main);
    font-size: 1.05rem;
    color: var(--text-primary);
    background-color: var(--bg-main);
    line-height: 1.8;

    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;

    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .page-width {
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 16px;
    box-sizing: border-box;
  }
</style>