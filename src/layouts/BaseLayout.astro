---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = "Neuroweave" } = Astro.props;

// 根据 URL 判断当前语言
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- 基础 Favicon 引入 -->
    <link rel="icon" type="image/png" href="/neuroweavelogo.png" />
    <link rel="shortcut icon" href="/neuroweavelogo.png" />
    <link rel="apple-touch-icon" href="/neuroweavelogo.png" />

    <!-- 引入思源宋体 (Noto Serif SC) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- 尽早应用护眼模式与字体模式，避免页面加载闪烁 -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('nw-sensory-theme') === 'true') {
            document.documentElement.classList.add('sensory-theme');
          }
          if (localStorage.getItem('nw-sans-serif-theme') === 'true') {
            document.documentElement.classList.add('sans-serif-theme');
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <!-- 1. 全局导航 -->
    <Nav />

    <!-- 2. 页面主体插槽（具体的 Header 和 Main 会插在这里） -->
    <slot />

    <!-- 3. 全局页脚 -->
    <Footer />
  </body>
</html>

<!-- is:global 确保全局字体、变量和基础样式对整个网站生效 -->
<style is:global>
:root {
  --bg-main: #F8F4E6;       /* 柔和暖米黄背景 */
  --bg-nav: #F2EDD8;        /* 导航栏底色 */
  
  /* -------------------------------------------------------------
     卡片底色微调：
     原先：#FFF9E8 (偏白、亮)
     现改为：#F5EBCF (淡雅、明确有黄色调，像温润的黄奶油/麦秆纸)
  ------------------------------------------------------------- */
  --bg-card: #F5EBCF;

  /* 卡片页眉底色：同步微调加深，保持轻微的层级区分 */
  --card-header-bg: #EADCB8;

  --text-primary: #2C2C2C;
  --text-muted: #6B6A65;
  --accent-border: rgba(70, 65, 50, 0.08);

  /* 思源宋体优先（Noto Serif SC 即 Google Fonts 版思源宋体） */
  --font-serif: "Noto Serif SC", "Source Han Serif SC", "Source Han Serif CN", "Songti SC", "STSong", "SimSun", Georgia, serif;
  /* 无衬线字体组合（黑体） */
  --font-sans: "Hiragino Sans GB", "冬青黑体", "Microsoft YaHei", "微软雅黑", -apple-system, BlinkMacSystemFont, sans-serif;

  /* 默认全站字体设定为衬线体 */
  --font-main: var(--font-serif);
}

  /* 点击导航栏“无衬线”按钮后激活，全站切换为无衬线字体（黑体） */
  :root.sans-serif-theme {
    --font-main: var(--font-sans);
  }

  /* 暗色系模式：低对比度、感官友好的暗色配色，作用于全站 */
  :root.sensory-theme {
    --bg-main: #161B24;
    --bg-nav: #1E2430;
    --bg-card: #1E2430;
    --text-primary: #93A8C7;
    --text-muted: #6E7F98;
    --accent-border: rgba(255, 255, 255, 0.08);
    --badge-bg: #2A3B4D;
    --card-header-bg: #171B24;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: var(--font-main);
    font-size: 1.05rem; /* 全局字号稍微放大 */
    color: var(--text-primary);
    background-color: var(--bg-main);
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .page-width {
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 16px;
    box-sizing: border-box;
  }
</style>