---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = "Neuroweave" } = Astro.props;

// 根据 URL 判断当前语言
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- 基础 Favicon 引入 -->
    <link rel="icon" type="image/png" href="/neuroweavelogo.png" />
    <link rel="shortcut icon" href="/neuroweavelogo.png" />
    <link rel="apple-touch-icon" href="/neuroweavelogo.png" />

    <!-- 尽早应用护眼模式，避免切换主题时的闪烁 -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('nw-sensory-theme') === 'true') {
            document.documentElement.classList.add('sensory-theme');
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <!-- 1. 全局导航 -->
    <Nav />

    <!-- 2. 页面主体插槽（具体的 Header 和 Main 会插在这里） -->
    <slot />

    <!-- 3. 全局页脚 -->
    <Footer />
  </body>
</html>

<!-- is:global 确保全局字体、变量和基础样式对整个网站生效 -->
<style is:global>
:root {
  --bg-main: #EFECE6;        /* 沉稳燕麦暖灰，去除刺眼白光 */
  --bg-nav: #E3DFD7;         /* 质感偏重的灰质导航栏 */
  --bg-card: #E8E4DC;        /* 低饱和软纸卡片色 */
  --text-primary: #383531;    /* 暗炭棕黑，比纯黑轻盈柔和很多 */
  --text-muted: #736E67;      /* 温和岩灰 */
  --accent-border: rgba(56, 53, 49, 0.08);
  --card-header-bg: #D8D3C8;  /* 深哑光燕麦 Header */
  --font-serif: "Hiragino Sans GB", "冬青黑体", "Microsoft YaHei", "微软雅黑", sans-serif;
}

  /* 暗色系模式：低对比度、感官友好的暗色配色，作用于全站 */
  :root.sensory-theme {
    --bg-main: #161B24;
    --bg-nav: #1E2430;
    --bg-card: #1E2430;
    --text-primary: #93A8C7;
    --text-muted: #6E7F98;
    --accent-border: rgba(255, 255, 255, 0.08);
    --badge-bg: #2A3B4D;
    --card-header-bg: #171B24;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: var(--font-serif);
    color: var(--text-primary);
    background-color: var(--bg-main);
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .page-width {
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 16px;
    box-sizing: border-box;
  }
</style>