---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const aboutModules = import.meta.glob('/src/content/about.md', { eager: true });
const aboutEntry = Object.values(aboutModules)[0] as any;
const AboutContent = aboutEntry?.default;

const ethicsModules = import.meta.glob('/src/content/about-ethics.md', { eager: true });
const ethicsEntry = Object.values(ethicsModules)[0] as any;
const AboutEthicsContent = ethicsEntry?.default;

const teamModules = import.meta.glob('/src/content/about-team.md', { eager: true });
const teamEntry = Object.values(teamModules)[0] as any;
const TeamContent = teamEntry?.default;

const workstyleModules = import.meta.glob('/src/content/about-workstyle.md', { eager: true });
const workstyleEntry = Object.values(workstyleModules)[0] as any;
const WorkstyleContent = workstyleEntry?.default;
---

<BaseLayout title="Neuroweave 神经丝织者 - 关于我们">
  <Header subtitle="关注神经多样性的中文知识共享社群。">
    <h1 slot="title">关于我们</h1>
  </Header>

  <main class="about-container">
    <section class="about-card">
      <h2>我们是谁</h2>
      <div class="markdown-content">
        {AboutContent ? <AboutContent /> : <p>内容整理中。</p>}
      </div>
    </section>

      <section class="about-card">
      <h2>神经丝织者的运作方式</h2>
      <div class="markdown-content">
        {WorkstyleContent ? <WorkstyleContent /> : <p>内容整理中。</p>}
      </div>
    </section>

      <section class="about-card">
      <h2>神经丝织者重视的伦理和原则</h2>
      <div class="markdown-content">
        {AboutContent ? <AboutEthicsContent /> : <p>内容整理中。</p>}
      </div>
    </section>



    <section class="about-card">
      <h2>小组成员</h2>
      <div class="team-content">
        {TeamContent ? <TeamContent /> : <p>内容整理中。</p>}
      </div>
    </section>

    <section class="about-card">
      <h2>我们做什么</h2>
      <div class="about-grid">
        <div class="about-item">
          <h3>NW 翻译</h3>
          <p>翻译海外神经发散/神经多样性相关的文章、事实清单与研究综述，降低中文读者的阅读门槛。</p>
          <a href="/reading/translations">进入文章列表 →</a>
        </div>
        <div class="about-item">
          <h3>NW 概述</h3>
          <p>由小组成员对某个神经多样性主题进行整理与概述，提供一份易懂的入门参考。</p>
          <a href="/reading/overviews">进入概述列表 →</a>
        </div>
        <div class="about-item">
          <h3>NW 访谈</h3>
          <p>记录我们与其他自倡导群体、公益团体及实践者的对话过程，呈现更多元的真实经验。</p>
          <a href="/reading/conversations">进入访谈列表 →</a>
        </div>
      </div>
    </section>

    <section class="about-card">
      <h2>无障碍与感官友好</h2>
      <p>
        我们希望阅读体验对更多人友好。目前网站提供全文搜索、标签检索、字号调整、
        阅读尺与低对比度的护眼模式（可在顶部导航栏切换）。如果你有更多无障碍方面的建议，
        欢迎通过<a href="/feedback">反馈页面</a>告诉我们。
      </p>
    </section>

    <section class="about-card">
      <h2>合作伙伴</h2>
      <div class="partners-grid">
        <a class="partner-item" href="https://abilitybeyondborders.org" target="_blank" rel="noopener noreferrer">
          <img src="/ability-beyond-borders.png" alt="Ability Beyond Borders" />
          <div class="partner-info">
            <h3>Ability Beyond Borders</h3>
            <p>Working Together for Equality &amp; Inclusion</p>
          </div>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .about-card {
    background-color: var(--bg-card);
    padding: 32px;
    border-radius: 12px;
    border: 1px solid var(--accent-border);
  }

  .about-card h2 {
    margin: 0 0 16px 0;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  .about-card p {
    margin: 0;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .about-card a {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .markdown-content :global(p) {
    margin: 0 0 12px 0;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .markdown-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .markdown-content :global(strong) {
    font-weight: 700;
  }

  .markdown-content :global(u) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .team-content :global(.team-member) {
    background-color: #fffef7;
    border: 1px solid var(--accent-border);
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 16px;
  }

  .team-content :global(.team-member:last-child) {
    margin-bottom: 0;
  }

  .team-content :global(.team-member p) {
    margin: 0;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .team-content :global(.team-member strong) {
    font-size: 1.05rem;
  }

  .partners-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .partner-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background-color: #fffef7;
    border: 1px solid var(--accent-border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .partner-item:hover {
    border-color: var(--text-primary);
  }

  .partner-item img {
    height: 48px;
    width: auto;
    flex-shrink: 0;
  }

  .partner-info h3 {
    margin: 0 0 4px 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .partner-info p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .about-item h3 {
    margin: 0 0 8px 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .about-item p {
    margin: 0 0 8px 0;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .about-item a {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .about-item a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .about-card {
      padding: 24px 20px;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
