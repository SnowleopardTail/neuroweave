---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

const aboutModules = import.meta.glob('/src/content/about-en.md', { eager: true });
const aboutEntry = Object.values(aboutModules)[0] as any;
const AboutContent = aboutEntry?.default;

const ethicsModules = import.meta.glob('/src/content/about-ethics-en.md', { eager: true });
const ethicsEntry = Object.values(ethicsModules)[0] as any;
const AboutEthicsContent = ethicsEntry?.default;

const teamModules = import.meta.glob('/src/content/about-team-en.md', { eager: true });
const teamEntry = Object.values(teamModules)[0] as any;
const TeamContent = teamEntry?.default;

const workstyleModules = import.meta.glob('/src/content/about-workstyle-en.md', { eager: true });
const workstyleEntry = Object.values(workstyleModules)[0] as any;
const WorkstyleContent = workstyleEntry?.default;
---

<BaseLayout title="Neuroweave - About Us">
  <Header subtitle="A Chinese-language knowledge-sharing group focused on neurodiversity.">
    <h1 slot="title">About Us</h1>
  </Header>

  <main class="about-container">

    <section class="about-card">
      <div class="markdown-content">
        {AboutContent ? <AboutContent /> : <p>Content coming soon.</p>}
      </div>
    </section>

    <section class="about-card">
      <h2>How Neuroweave Works</h2>
      <div class="markdown-content">
        {WorkstyleContent
          ? <WorkstyleContent />
          : <p>Content coming soon.</p>}
      </div>
    </section>

    <section class="about-card">
      <h2>Our Ethics and Principles</h2>
      <div class="markdown-content">
        {AboutEthicsContent
          ? <AboutEthicsContent />
          : <p>Content coming soon.</p>}
      </div>
    </section>

    <section class="about-card">
      <h2>Our Team</h2>
      <div class="team-content">
        {TeamContent
          ? <TeamContent />
          : <p>Content coming soon.</p>}
      </div>
    </section>

    <section class="about-card">
      <h2>What We Do</h2>

      <div class="about-grid">
        <div class="about-item">
          <h3>NW Translation</h3>
          <p>
            We translate articles, fact sheets, and research reviews about
            neurodivergence and neurodiversity, making these resources more
            accessible to Chinese-speaking readers.
          </p>
          <a href="/en/reading/translations">View translations →</a>
        </div>

        <div class="about-item">
          <h3>NW Overview</h3>
          <p>
            Our group members prepare overviews of different topics related to
            neurodiversity, providing accessible introductions and references.
          </p>
          <a href="/en/reading/overviews">View overviews →</a>
        </div>

        <div class="about-item">
          <h3>NW Conversations</h3>
          <p>
            We document conversations with self-advocacy groups, nonprofit
            organizations, practitioners, and others, bringing together a wider
            range of lived experiences and perspectives.
          </p>
          <a href="/en/reading/conversations">View conversations →</a>
        </div>
      </div>
    </section>

    <section class="about-card">
      <h2>Accessibility and Sensory Friendliness</h2>
      <p>
        We want the reading experience to be accessible and comfortable for as
        many people as possible. The website currently provides full-text
        search, tag-based browsing, text-size adjustment, a reading ruler, and
        a sensory-friendly dark mode, which can be switched on from the top
        navigation bar.
        If you have suggestions about accessibility, please let us know through
        the <a href="/en/feedback">feedback page</a>.
      </p>
    </section>

    <section class="about-card">
      <h2>Partners</h2>

      <div class="partners-grid">
        <a
          class="partner-item"
          href="https://abilitybeyondborders.org"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="/ability-beyond-borders.png"
            alt="Ability Beyond Borders"
          />

          <div class="partner-info">
            <h3>Ability Beyond Borders</h3>
            <p>Working Together for Equality &amp; Inclusion</p>
          </div>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .about-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .about-card {
    background-color: var(--bg-card);
    padding: 32px;
    border-radius: 12px;
    border: 1px solid var(--accent-border);
  }

  .about-card h2 {
    margin: 0 0 16px 0;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  .about-card p {
    margin: 0;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .about-card a {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .markdown-content :global(p) {
    margin: 0 0 12px 0;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .markdown-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .markdown-content :global(strong) {
    font-weight: 700;
  }

  .markdown-content :global(u) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .markdown-content :global(h1),
  .markdown-content :global(h2),
  .markdown-content :global(h3) {
    color: var(--text-primary);
  }

  .team-content :global(.team-member) {
    background-color: #fffef7;
    border: 1px solid var(--accent-border);
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 16px;
  }

  .team-content :global(.team-member:last-child) {
    margin-bottom: 0;
  }

  .team-content :global(.team-member p) {
    margin: 0;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .team-content :global(.team-member strong) {
    font-size: 1.05rem;
  }

  .partners-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .partner-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background-color: #fffef7;
    border: 1px solid var(--accent-border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .partner-item:hover {
    border-color: var(--text-primary);
  }

  .partner-item img {
    height: 48px;
    width: auto;
    flex-shrink: 0;
  }

  .partner-info h3 {
    margin: 0 0 4px 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .partner-info p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .about-item h3 {
    margin: 0 0 8px 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .about-item p {
    margin: 0 0 8px 0;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .about-item a {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .about-item a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .about-card {
      padding: 24px 20px;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>